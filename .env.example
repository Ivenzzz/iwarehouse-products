ERP_CATALOG_API_URL=http://localhost:8000/api/v1/catalog
ERP_CATALOG_API_TOKEN=replace-with-a-long-random-token
# Accounts and reviews. Uses the same token as the catalog.
ERP_STOREFRONT_API_URL=http://localhost:8000/api/v1/storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# false: shoppers see no accounts or reviews, but /account/* works by direct URL
# so staff can test. true: launched. Changing it needs `bash deploy.sh --force`.
CUSTOMER_REVIEWS_LIVE=false
